  "description": "MCP server bridging an LLM agent (OpenClaw) to the OurWorlds game's TCP agent-control API (NDJSON over plain TCP).",
  "type": "module",
  "bin": {
    "ourworlds-mcp": "dist/index.js"
  },
  "files": [
    "dist",
