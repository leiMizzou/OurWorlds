[resource]
default_font_size = 15

; ---- Label 字阶 type variations ----
; H1：界面主标题（如 VoxelCraft / 暂停标题）
Label/font_sizes/H1 = 30
Label/colors/H1 = Color(1.0, 0.98, 0.94, 0.98)
; H2：区块/分组标题
Label/font_sizes/H2 = 20
Label/colors/H2 = Color(1.0, 0.95, 0.86, 0.94)
; Body：正文
Label/font_sizes/Body = 15
Label/colors/Body = Color(0.9, 0.95, 1.0, 0.9)
; Caption：辅助说明/弱化信息
Label/font_sizes/Caption = 12
Label/colors/Caption = Color(0.78, 0.86, 0.95, 0.72)

; ---- Button 四态 ----
Button/colors/font_color = Color(0.92, 0.96, 1.0, 0.95)
Button/colors/font_hover_color = Color(1.0, 0.98, 0.92, 1.0)
Button/colors/font_pressed_color = Color(1.0, 0.9, 0.62, 1.0)
Button/colors/font_focus_color = Color(0.95, 0.98, 1.0, 1.0)
Button/colors/font_disabled_color = Color(0.7, 0.76, 0.82, 0.45)
Button/colors/font_hover_pressed_color = Color(1.0, 0.9, 0.62, 1.0)
Button/styles/normal = SubResource("btn_normal")
Button/styles/hover = SubResource("btn_hover")
Button/styles/pressed = SubResource("btn_pressed")
Button/styles/disabled = SubResource("btn_disabled")
Button/styles/focus = SubResource("btn_focus")

; ---- OptionButton（沿用按钮风格，画质下拉等用）----
OptionButton/colors/font_color = Color(0.92, 0.96, 1.0, 0.95)
OptionButton/colors/font_hover_color = Color(1.0, 0.98, 0.92, 1.0)
OptionButton/colors/font_pressed_color = Color(1.0, 0.9, 0.62, 1.0)
OptionButton/colors/font_focus_color = Color(0.95, 0.98, 1.0, 1.0)
OptionButton/colors/font_disabled_color = Color(0.7, 0.76, 0.82, 0.45)
OptionButton/styles/normal = SubResource("btn_normal")
OptionButton/styles/hover = SubResource("btn_hover")
OptionButton/styles/pressed = SubResource("btn_pressed")
OptionButton/styles/disabled = SubResource("btn_disabled")
OptionButton/styles/focus = SubResource("btn_focus")

; ---- CheckBox（动态天气开关等）----
CheckBox/colors/font_color = Color(0.9, 0.95, 1.0, 0.92)
CheckBox/colors/font_hover_color = Color(1.0, 0.98, 0.92, 1.0)
CheckBox/colors/font_pressed_color = Color(1.0, 0.9, 0.62, 1.0)
CheckBox/colors/font_disabled_color = Color(0.7, 0.76, 0.82, 0.45)

; ---- Panel / PanelContainer ----
Panel/styles/panel = SubResource("panel_box")
PanelContainer/styles/panel = SubResource("panelcontainer_box")

; ---- LineEdit（新世界种子输入等）----
LineEdit/colors/font_color = Color(0.94, 0.98, 1.0, 0.96)
LineEdit/colors/font_placeholder_color = Color(0.78, 0.86, 0.95, 0.5)
LineEdit/colors/caret_color = Color(1.0, 0.9, 0.62, 1.0)
LineEdit/styles/normal = SubResource("lineedit_normal")
LineEdit/styles/focus = SubResource("lineedit_focus")
